# ============================================================
# TEMPLATE DE CONFIGURAÇÃO — Copie para .env e preencha
# NUNCA commite o arquivo .env com dados reais!
# ============================================================

# Microsoft Fabric (SQL Server)
# Exemplo: seu-servidor.database.fabric.microsoft.com
FABRIC_SERVER=SEU_SERVIDOR_FABRIC_AQUI

# Nome do banco de dados no Fabric
FABRIC_DATABASE=NOME_DO_BANCO_AQUI

# Ambiente de execução: PRODUCAO | TESTE
AMBIENTE=PRODUCAO
